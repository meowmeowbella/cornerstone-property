---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}
const { href, variant = 'primary' } = Astro.props;
---
<a class={`btn btn-${variant}`} href={href}><slot /></a>

<style>
  .btn {
    display: inline-block; padding: 0.85rem 1.6rem; border-radius: var(--radius);
    font-weight: 600; text-decoration: none; border: 2px solid transparent;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .btn-primary { background: var(--brass); color: var(--slate-950); }
  .btn-primary:hover { background: var(--brass-dark); color: #fff; }
  .btn-secondary { border-color: currentColor; color: inherit; }
  .btn-secondary:hover { background: rgb(255 255 255 / 0.1); }
</style>
