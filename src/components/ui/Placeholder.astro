---
// Stand-in for photography. Replace with Astro's <Image> once real photos exist.
interface Props {
  label: string;
  ratio?: string;
}
const { label, ratio = '4 / 3' } = Astro.props;
---
<div class="placeholder" style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Placeholder: ${label}`}>
  <span>{label}</span>
</div>

<style>
  .placeholder {
    display: grid; place-items: center; width: 100%;
    background: repeating-linear-gradient(135deg, var(--slate-700) 0 2px, var(--slate-900) 2px 14px);
    color: var(--slate-200); font-size: var(--text-sm); border-radius: var(--radius);
  }
</style>
