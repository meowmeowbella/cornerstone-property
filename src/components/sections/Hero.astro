---
import Button from '../ui/Button.astro';
import Placeholder from '../ui/Placeholder.astro';
import { hero } from '../../data/site';
---
<section id="top" class="hero">
  <div class="inner">
    <div class="copy">
      <h1>{hero.heading}</h1>
      <p>{hero.text}</p>
      <div class="actions">
        <Button href={hero.primaryCta.href}>{hero.primaryCta.label}</Button>
        <Button href={hero.secondaryCta.href} variant="secondary">{hero.secondaryCta.label}</Button>
      </div>
    </div>
    <div class="media"><Placeholder label="Hero image: flagship property" ratio="4 / 5" /></div>
  </div>
</section>

<style>
  .hero { background: var(--slate-900); color: #fff; padding-block: var(--space-5) var(--space-6); }
  .inner { width: min(100% - 2.5rem, var(--max-width)); margin-inline: auto; display: grid; gap: var(--space-4); align-items: center; }
  h1 { font-size: var(--text-hero); max-width: 14ch; }
  p { font-size: var(--text-lg); color: var(--slate-200); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  @media (min-width: 56rem) { .inner { grid-template-columns: 1.2fr 0.8fr; gap: var(--space-5); } }
</style>
